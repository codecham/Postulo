# Environment variables for local development and Docker Compose.
#
# `make setup` creates .env from this file and generates the empty secrets for you.
# Never commit .env. Values left empty below are secrets: an empty value stops the app.

APP_NAME="Postulo"

# --- PostgreSQL ---
POSTGRES_USER=postulo
POSTGRES_PASSWORD=
POSTGRES_DB=postulo
# Port published on your machine (change it if 5432 is already used)
POSTGRES_PORT=5432

# --- API ---
API_PORT=8000
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Session length when "Keep me signed in" is ticked at login
REMEMBER_ME_EXPIRE_DAYS=30
# false: nobody can sign up, create accounts with `make create-user` (private instance)
REGISTRATION_OPEN=true

# --- AI: CV import and tailored applications (Claude API) ---
# Key from https://platform.claude.com. Optional: without it, both answer 503 and the app
# offers the free Claude Code commands (/import-cv, /tailor-application) instead.
ANTHROPIC_API_KEY=

# --- Job search (worker) ---
# Free keys from https://developer.adzuna.com. Optional: without them, the search only
# uses job boards that need no key (remote jobs).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Web ---
WEB_PORT=3000
