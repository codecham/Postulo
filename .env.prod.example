# Environment for the production stack (compose.prod.yaml).
#
# Copy it to .env.prod on the server and fill it in, or run `make prod-env`, which
# generates the secrets for you. Never commit .env.prod.
# Usage: docker compose -f compose.prod.yaml --env-file .env.prod up -d  (or `make prod-up`)

# --- Required ---

# Public domain name, pointing (DNS A/AAAA record) to the server. Caddy gets the HTTPS
# certificate for it on first start. Use "localhost" to try the stack on your machine.
DOMAIN=localhost

POSTGRES_USER=postulo
POSTGRES_DB=postulo
# Secret. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Secret, at least 32 characters. Generate with: openssl rand -hex 32
# Changing it logs every user out.
JWT_SECRET_KEY=

# --- Optional ---

APP_NAME="Postulo"
# Lifetime of a login session, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Session length when "Keep me signed in" is ticked at login
REMEMBER_ME_EXPIRE_DAYS=30
# false: only accounts created with `make create-user` can log in (private instance)
REGISTRATION_OPEN=true
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Claude API key (https://platform.claude.com): enables the PDF CV import and the
# tailored applications. Without it, both answer 503 and the app offers the free
# Claude Code commands instead. Each user is limited per hour (see app/core/config.py).
ANTHROPIC_API_KEY=

# Free Adzuna keys (https://developer.adzuna.com): add on-site offers to the job search
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Ports published by Caddy on the server. Change them only to test locally when 80/443
# are taken (Let's Encrypt needs 80 and 443 on a real server).
HTTP_PORT=80
HTTPS_PORT=443
